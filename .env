# BhuSetu Environment Configuration
PROJECT_NAME="BhuSetu"
API_V1_STR="/api"
SECRET_KEY="bhusetu-hackathon-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./bhusetu.db"

# Storage
STORAGE_DIR="data/storage"

# OCR and Vision Engines
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
TESSERACT_CMD=""

# Confidence and Routing Policies
AUTO_ACCEPT_THRESHOLD=0.90
FIELD_REVIEW_THRESHOLD=0.60

# Mock Mode (use ground_truth.json when Gemini API is unavailable or offline)
MOCK_OCR_MODE=true
