# ==============================================================================
# BhuSetu Git Ignore File
# Prevents bulky, temporary, and machine-specific files from being uploaded
# ==============================================================================

# Python Virtual Environments (CRITICAL - DO NOT COMMIT)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend Dependencies (CRITICAL - DO NOT COMMIT)
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local Environment Secrets (Keep .env.example committed)
.env
.env.local
.env.production

# SQLite Databases & Local Runtime Data
*.db-journal
*.sqlite3-journal

# Temporary Upload Storage (keep directory structure with .gitkeep)
data/cache/*
data/storage/originals/*
data/storage/processed/*
data/storage/pages/*
!data/storage/originals/.gitkeep
!data/storage/processed/.gitkeep
!data/storage/pages/.gitkeep

# IDEs & Operating System Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
